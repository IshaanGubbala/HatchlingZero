FROM pytorch/pytorch:2.9.0-cuda12.8-cudnn9-devel

ENV TORCH_CUDA_ARCH_LIST="8.0;9.0+PTX"
ENV MAX_JOBS=2
ENV NVCC_THREADS=2
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
        git libz3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Mirror the upstream GDN-2 environment shape first.
COPY vendor/GatedDeltaNet-2/requirements.txt /tmp/gdn2-requirements.txt
RUN pip install --no-cache-dir -r /tmp/gdn2-requirements.txt

RUN pip install --no-cache-dir packaging psutil ninja
RUN pip install --no-cache-dir "causal-conv1d==1.6.1" --no-build-isolation
RUN pip install --no-cache-dir "flash-attn==2.8.3" --no-build-isolation
RUN pip install --no-cache-dir -U \
    git+https://github.com/fla-org/flash-linear-attention \
    --no-build-isolation

# Install the local HZ-0A repo on top of the upstream stack.
COPY . /workspace
RUN pip install --no-cache-dir -e .

CMD ["/bin/bash"]
